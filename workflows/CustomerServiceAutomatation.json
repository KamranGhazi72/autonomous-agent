        "jsCode": "const responseJson = $input.first().json;\nconst rawText = responseJson.text || responseJson.output || JSON.stringify(responseJson);\nconst jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\n\nlet leadData = {};\ntry {\n  leadData = JSON.parse(jsonMatch ? jsonMatch[0] : rawText);\n} catch (e) {\n  leadData = {\n    budget: \"Not specified\",\n    timeline: \"Not specified\",\n    project_scope: \"General inquiry\",\n    lead_score: 5,\n    reply_message: \"سپاس از پیام شما. درخواست شما ثبت شد و کارشناسان فروش ما به زودی با شما تماس خواهند گرفت.\"\n  };\n}\n\nconst score = Number(leadData.lead_score) || 5;\nconst priority = score >= 8 ? \"Hot\" : score >= 5 ? \"Warm\" : \"Cold\";\nconst baseData = $('Parse Intent JSON').first().json;\n\nreturn [{\n  json: {\n    chat_id: baseData.chat_id,\n    raw_message: baseData.user_message,\n    budget: leadData.budget || \"Not specified\",\n    timeline: leadData.timeline || \"Not specified\",\n    project_scope: leadData.project_scope || \"\",\n    lead_score: score,\n    priority: priority,\n    reply_message: leadData.reply_message\n  }\n}];"
