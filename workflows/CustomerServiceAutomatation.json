    {
      "parameters": {
        "jsCode": "const responseJson = $input.first().json;\n\n// 1. استخراج دقیق متن از مسیر مخفی در ساختار جدید نود LangChain Gemini\nlet rawText = \"\";\nif (responseJson.content && responseJson.content.parts && responseJson.content.parts.length > 0) {\n  rawText = responseJson.content.parts[0].text;\n} else if (responseJson.text) {\n  rawText = responseJson.text; \n} else {\n  rawText = JSON.stringify(responseJson);\n}\n\n// 2. پاک‌سازی کاراکترهای اضافه و استخراج فقط بلوک JSON\nlet cleanedText = \"\";\nconst jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\n\nif (jsonMatch) {\n  cleanedText = jsonMatch[0];\n} else {\n  cleanedText = rawText;\n}\n\nlet intentData = {};\nlet debugStatus = \"Success\";\n\n// 3. تبدیل ایمن به Object\ntry {\n  intentData = JSON.parse(cleanedText);\n} catch (error) {\n  debugStatus = \"Parse Error\";\n  intentData = {\n    intent: \"technical_support\", \n    confidence_score: 0.1,\n    summary: \"Defaulted due to parse error\"\n  };\n}\n\n// 4. دریافت اطلاعات کاربر (توجه: نام 'Edit Fields / Normalize' باید دقیقاً نام نود فاز ۲ شما باشد)\nconst previousNodeData = $('Edit Fields Normalize').first().json || {};\n\n// 5. ارسال دیتای ساختاریافته برای نود Switch\nreturn [{\n  json: {\n    user_message: previousNodeData.user_message || \"No message\",\n    chat_id: previousNodeData.chat_id || \"\",\n    intent: intentData.intent || \"technical_support\",\n    confidence_score: intentData.confidence_score || 0,\n    summary: intentData.summary || \"\",\n    _debug_status: debugStatus\n  }\n}];"
      },
